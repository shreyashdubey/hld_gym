.playwright-mcp/
__pycache__/
node_modules/

# Screenshots and contact sheets are working artifacts, never deliverables.
# dist/ is the exception: Vercel serves it with no build step, so what ships
# has to be committed.
*.png
!dist/**/*.png

# the sell app (Next)
sell/.next/
sell/out/
sell/*.tsbuildinfo
sell/next-env.d.ts
sell/.env*
sell/.vercel
# Dev-only symlink to the book, created by predev.
sell/public/book

# reel renderer: the source is reel/*.html|css|js|mjs|sh, everything below is
# output. Full-resolution masters stay local; the small web encodes live in
# dist/reels/ because that is what the site actually serves.
reel/frames-*/
reel/beats-*/
reel/*.mp4
reel/preview-*.html
reel/index.html
