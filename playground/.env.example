# Never commit the real file. The key stays server-side; see the plan's Global Constraints.
OPENAI_API_KEY=sk-replace-me

# ---------------------------------------------------------------------------
# Auth. mode=playground requires a Google sign-in; mode=dictation does not.
# See playground/README.md's "Auth" section and playground/auth.py.
# ---------------------------------------------------------------------------

# Public by design -- also needs to reach the browser via
# sell/.env.local's NEXT_PUBLIC_PLAYGROUND_GOOGLE_CLIENT_ID (same value).
# PLAYGROUND_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Secret, and REQUIRED for mode=playground: the service refuses to start
# without it (see playground/auth.py's token_secret_from_env) rather than
# fall back to a guessable default -- that refusal is intentional and stays,
# so this is commented out here rather than given a working placeholder.
# Uncomment and generate a real value:
# `python3 -c "import secrets; print(secrets.token_urlsafe(48))"`.
# PLAYGROUND_TOKEN_SECRET=

# How long our own session token lasts before a learner signs in again.
# PLAYGROUND_SESSION_TTL_SECS=604800
